class Stack:
    def __init__(self):
        self.stack = []

    def push(self, item):
        self.stack.append(item)
        print(f"{item} pushed to book stack")

    def pop(self):
        if len(self.stack) == 0:
            print("Book stack underflow")
            return
        return self.stack.pop()

    def peek(self):
        if len(self.stack) == 0:
            print("Book stack is empty")
            return
        return self.stack[-1]

    def display(self):
        print("Book stack elements are ", self.stack)


s = Stack()
n = int(input("Enter number of book: "))
for i in range(n):
    data = input("Enter a data: ")
    s.push(data)

print("\nArray :")
s.display()

print("1. push")
print("2. pop")
print("3. peek")

choice = input("\nEnter your choice: ")

if choice == "push":
    data = input("Enter a data to insert: ")
    s.push(data)
    print("\nAfter pushed: ")
    s.display()
elif choice == "pop":
    s.pop()
    print("\nAfter popped")
    s.display()
elif choice == "peek":
    print("\npeek value: ", s.peek())
    s.display()
else:
    print("Invalid Input")

operators=set(['+','-','*','/','(',')','^'])
priority={'+':1,'-':1,'*':2,'/':2,'^':3}
def infix(expression):
    stack=[]
    output=''
    for i in expression:
        if i not in operators:
            output+=i
        elif i=='(':
            stack.append('(')
        elif i==')':
            while stack and stack[-1]!='(':
                output+=stack.pop()
            stack.pop()
        else:
            while stack and stack[-1]!='(' and priority[i]<=priority[stack[-1]]:
                output+=stack.pop()
            stack.append(i)
    while stack:
        output+=stack.pop()
    return output     

          
        
expression=input("Enter infix expression:")
print("Infix expression:",expression)
print("Postfix expression:",infix(expression))
